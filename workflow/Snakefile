rule beneficial_table:
    input:
        top20 = f"{home}/input/metaphlan/New_Top20.xlsx",
        updated = f"{home}/input/metaphlan/New_List_of_Organisms_Updated.xlsx",
        csv= f"{home}/output/metaphlan/{sample}_species.csv",
    output:
        csv = f"{home}/output/metaphlan/{sample}_beneficial_sp.csv",
    conda:
        f"{home}/envs/r_env.yml"
    params:
        script= f"{home}/scripts/beneficial_sp.R",
    shell:
        """
        Rscript {params.script} {input.top20} {input.updated} {input.csv} {output.csv}
        """
rule gmwi2_score:
    input:
        mpa3 = f"{home}/input/metaphlan/{sample}_metaphlan.txt"
    output:
        score = f"{home}/output/metaphlan/{sample}_gmwi2_score.txt",
        taxa = f"{home}/output/metaphlan/{sample}_gmwi2_taxa.txt",
    conda:
        f"{home}/envs/gmwi2_env.yml"
    params:
        script =f"{home}/GMWI2/src/GMWI2/my.py"
    shell:
        """
        python -m pip show joblib || python -m pip install joblib
        python -m pip show halo || python -m pip install halo
        python -m pip show scikit-learn || python -m pip install scikit-learn
        python {params.script} {input.mpa3} {output.score} {output.taxa}
        """
rule gmwi2_plot:
    input:
        score = f"{home}/output/metaphlan/{sample}_gmwi2_score.txt",
    output:
        plot = f"{home}/output/metaphlan/{sample}_gmwi2_plot.png",
        csv= f"{home}/output/metaphlan/{sample}_gmwi2.csv"
    conda:
        f"{home}/envs/r_env.yml"
    params:
        script= f"{home}/scripts/gmwi2_plot.R",
    shell:
        """
        Rscript {params.script} {input.score} {output.plot} {output.csv}
        """
rule merge_metadata:
    input:
        metrics= f"{home}/output/metaphlan/{sample}_metrics.csv",
        fb= f"{home}/output/metaphlan/{sample}_fb.csv",
        gmwi2 = f"{home}/output/metaphlan/{sample}_gmwi2.csv",
        count_file = f"{home}/output/metaphlan/{sample}_count.csv"
    output:
        csv= f"{home}/output/metaphlan/{sample}_metadata.csv"
    params:
        script= f"{home}/scripts/merge.py",
    shell:
        """
        python {params.script} {input.metrics} {input.fb} {input.gmwi2} {input.count_file} {output.csv}
        """
rule pdf_generation:
    input:
        meta= f"{home}/output/metaphlan/{sample}_metadata.csv"
    output:
        pdf = f"{home}/output/metaphlan/{sample}_Gut_microbiome.pdf"
    params:
        script= f"{home}/scripts/HPc_Python_copy.py",
        home_dir = f"{home}"
    shell:
        """
        pip install reportlab
        python {params.script} {input.meta} {output.pdf} {params.home_dir}
        """