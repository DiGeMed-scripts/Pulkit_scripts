# Snakefile
configfile: "config/config.yml"
home= config["home_dir"]
sample= "Sample001"
rule all:
    input:
        parse_ph = expand(f'{home}/output/metaphlan/{sample}_phylum.csv',home= home, sample=sample),
        parse_sp = expand(f'{home}/output/metaphlan/{sample}_species.csv',home= home, sample=sample),
        pie_plot = expand(f"{home}/output/metaphlan/{sample}_phylum.png",home= home, sample=sample),
        count_file= expand(f"{home}/output/metaphlan/{sample}_count.csv",home= home, sample=sample),
        ratio_plot = expand(f"{home}/output/metaphlan/{sample}_phylum_ratio.png",home= home, sample=sample),
        fb = expand(f"{home}/output/metaphlan/{sample}_fb.csv",home= home, sample=sample),
        top15_plot = expand(f"{home}/output/metaphlan/{sample}_species_top15.png",home= home, sample=sample),
        metrics= expand(f"{home}/output/metaphlan/{sample}_metrics.csv",home= home, sample=sample),
        richness= expand(f"{home}/output/metaphlan/{sample}_gauge_richness.png",home= home, sample=sample),
        shannon= expand(f"{home}/output/metaphlan/{sample}_gauge_shannon.png",home= home, sample=sample),
        evenness= expand(f"{home}/output/metaphlan/{sample}_gauge_evenness.png",home= home, sample=sample),
        beneficial= expand(f"{home}/output/metaphlan/{sample}_beneficial_sp.csv",home= home, sample=sample),
        gmwi2_score = expand(f"{home}/output/metaphlan/{sample}_gmwi2_score.txt",home= home, sample=sample),
        gmwi2_taxa = expand(f"{home}/output/metaphlan/{sample}_gmwi2_taxa.txt",home= home, sample=sample),
        gmwi2_plot = expand(f"{home}/output/metaphlan/{sample}_gmwi2_plot.png",home= home, sample=sample),
        gmwi2_csv = expand(f"{home}/output/metaphlan/{sample}_gmwi2.csv",home= home, sample=sample),
        metadata = expand(f"{home}/output/metaphlan/{sample}_metadata.csv",home= home, sample=sample),
        pdf = expand(f"{home}/output/metaphlan/{sample}_Gut_microbiome.pdf",home= home, sample=sample)
    
rule install_r_packages:
    input:
        f"{home}/scripts/install_packages.R"
    output:
        "logs/r_packages_installed.log"
    conda:
        f"{home}/envs/r_env.yml"
    shell:
        """
        Rscript {input}
        echo "R packages installed" > {output}
        """

rule parse_metaphlan:
    input:
        metaphlan = f"{home}/input/metaphlan/{sample}_profiled_mpa4.txt"
    output:
        phylum = f"{home}/output/metaphlan/{sample}_phylum.csv",
        species = f"{home}/output/metaphlan/{sample}_species.csv",
        count_file = f"{home}/output/metaphlan/{sample}_count.csv"
    script:
        f"{home}/scripts/parse_metaphlan.py"

rule plot_phylum_pie:
    input:
        table = f"{home}/output/metaphlan/{sample}_phylum.csv"
    output:
        plot = f"{home}/output/metaphlan/{sample}_phylum.png"
    conda:
        f"{home}/envs/r_env.yml"
    params:
        script= f"{home}/scripts/plot_phylum_piechart.R"
    shell:
        "Rscript {params.script} {input.table} {output.plot}"

rule plot_phylum_ratio:
    input:
        table = f"{home}/output/metaphlan/{sample}_phylum.csv"
    output:
        plot = f"{home}/output/metaphlan/{sample}_phylum_ratio.png",
        fb= f"{home}/output/metaphlan/{sample}_fb.csv"
    conda:
        f"{home}/envs/r_env.yml"
    params:
        script= f"{home}/scripts/plot_phylum_ratio.R"
    shell:
        "Rscript {params.script} {input.table} {output.plot} {output.fb}"

rule plot_species_top15:
    input:
        table = f"{home}/output/metaphlan/{sample}_species.csv"
    output:
        plot = f"{home}/output/metaphlan/{sample}_species_top15.png",
    conda:
        f"{home}/envs/r_env.yml"
    params:
        script= f"{home}/scripts/top15_2.R",
    shell:
        """
        Rscript {params.script} {input.table} {output.plot}
        """

rule calculate_metrics:
    input:
        csv= f"{home}/output/metaphlan/{sample}_species.csv",
    output:
        csv= f"{home}/output/metaphlan/{sample}_metrics.csv",
    conda:
        f"{home}/envs/r_env.yml"
    params:
        script= f"{home}/scripts/calculate_metrics.R",
    shell:
        """
        Rscript {params.script} {input.csv} {output.csv}
        """

